{
  "name": "wrdl",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @wrdl/web dev",
    "build": "pnpm --filter @wrdl/web build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "pnpm --filter @wrdl/web lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "catalog:check": "node scripts/validate-word-catalog.mjs",
    "catalog:write": "node scripts/validate-word-catalog.mjs --write",
    "daily-catalog:check": "node scripts/generate-daily-word-migration.mjs",
    "daily-catalog:write": "node scripts/generate-daily-word-migration.mjs --write",
    "backend:check": "node --env-file-if-exists=apps/web/.env.local scripts/verify-hosted-supabase.mjs",
    "database:test": "pwsh -NoProfile -File scripts/Invoke-WrdlDatabaseTests.ps1",
    "secrets:check": "node scripts/check-secrets.mjs",
    "accessibility:check": "node scripts/check-accessibility-contracts.mjs",
    "security:check": "node scripts/check-security-boundaries.mjs",
    "performance:check": "node scripts/check-build-budget.mjs",
    "realtime:rehearse": "pnpm --filter @wrdl/web realtime:rehearse",
    "smoke:production": "node scripts/smoke-production.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "supabase": "^2.116.0"
  }
}
