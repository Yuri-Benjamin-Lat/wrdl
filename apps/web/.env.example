# Safe browser-visible values. Use the values printed by `pnpm db:status` locally,
# or the Connect panel of the matching hosted Supabase project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only. Never prefix this with NEXT_PUBLIC and never commit a real value.
SUPABASE_SECRET_KEY=replace-with-server-secret-key
