# Hosted production Supabase project only. Configure these values in the
# deployment provider; never reuse development/staging project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-production-publishable-key

# Sentry project values. SENTRY_AUTH_TOKEN is a deployment secret used only to
# upload private source maps; never expose it with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SENTRY_DSN=https://replace-with-public-dsn@o0.ingest.sentry.io/0
SENTRY_DSN=https://replace-with-public-dsn@o0.ingest.sentry.io/0
SENTRY_ORG=replace-with-sentry-organization-slug
SENTRY_PROJECT=replace-with-sentry-project-slug
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token
WRDL_MAINTENANCE_MODE=false
